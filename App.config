<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="SysHesAnbDb" connectionString="Data Source=|DataDirectory|\Sys_Hes_Anb.db;Version=3;" providerName="System.Data.SQLite"/>
  </connectionStrings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2"/>
  </startup>
</configuration>
